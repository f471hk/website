<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>John Doe - CV</title>
    <style>
      /* Define some basic styles */
      body {
        font-family: Arial, sans-serif;
        color: #444444;
        background-color: #f1f1f1;
        line-height: 1.6;
        margin: 0;
        padding: 0;
      }
      
      /* Style the header */
      header {
        background-color: #ff9900;
        color: #ffffff;
        padding: 20px;
        text-align: center;
      }
      
      header h1 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 3em;
      }
      
      header p {
        margin-top: 0;
        margin-bottom: 0;
        font-size: 1.5em;
        font-weight: bold;
      }
      
      nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      
      nav ul li {
        display: inline-block;
        margin-right: 20px;
      }
      
      nav ul li a {
        color: #ffffff;
        text-decoration: none;
        font-size: 1.2em;
      }
      
      nav ul li a:hover {
        text-decoration: underline;
      }
      
      /* Style the main sections */
      main {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        background-color: #ffffff;
        border: 1px solid #dddddd;
        box-shadow: 0 0 10px #dddddd;
      }
      
      section h2 {
        margin-top: 0;
        font-size: 2em;
      }
      
      section ul {
        list-style: disc;
        margin-left: 20px;
      }
      
      section ul li {
        margin-bottom: 10px;
      }
      
      /* Style the contact section */
      #contact {
        background-color: #666666;
        color: #ffffff;
        text-align: center;
        padding: 20px;
      }
      
      #contact p {
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 1.2em;
      }
      
      #contact ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      
      #contact ul li {
        margin-bottom: 10px;
      }
      
      #contact ul li a {
        color: #ffffff;
        text-decoration: none;
        font-size: 1.2em;
      }
      
      #contact ul li a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>John Doe</h1>
      <p>Frontend Developer</p>
      <nav>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#education">Education</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <section id="about">
        <h2>About Me</h2>
